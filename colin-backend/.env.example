# Configure these on the backend service (Render), never in VITE_* variables.
PUBLIC_CLIENT_URL=https://colin-and-colin.vercel.app
CLIENT_URL=https://colin-and-colin.vercel.app

# Obtain a sending API key from the firm's Resend account.
# Use an address on a domain verified in that same Resend account.
RESEND_API_KEY=your_private_key
EMAIL_FROM="Colin & Colin Legal Solutions <info@colinandcolin.com>"
EMAIL_REPLY_TO="info@colinandcolin.com"
FINANCE_ALERT_EMAIL="cg@colinandcolin.com"
APP_TIMEZONE="Africa/Kigali"

# Controlled rollout: no automatic notification email until explicitly enabled.
NOTIFICATION_EMAIL_ENABLED=false
# Optional comma-separated safe recipients during rollout. Empty means all recipients.
NOTIFICATION_EMAIL_ALLOWLIST=
# Obtain from the Resend webhook details; never commit the real signing secret.
RESEND_WEBHOOK_SECRET=
# Local hour to send the previous complete day's petty cash summary (0-23).
PETTY_CASH_DIGEST_HOUR=8

# Keep the existing application JWT, MongoDB and other environment settings.
